{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "preLaunchTask": "rust: cargo build",
            "name": "probe-rs RP2350 Debug (Arm Cortex-M33)",
            "cwd": "${workspaceFolder}",
            "chip": "rp235x",
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": true
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "./target/thumbv8m.main-none-eabihf/debug/picolite"
                }
            ]
        }
    ]
}
